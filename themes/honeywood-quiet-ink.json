    "editor.lineHighlightBackground": "#F8F1E5",
    "editor.lineHighlightBorder": "#F8F1E5",
    "editor.selectionBackground": "#D4E4F4",
    "editor.inactiveSelectionBackground": "#E3ECF5",
    "editor.selectionHighlightBackground": "#DCEAF7B3",
    "editor.wordHighlightBackground": "#DCEAF799",
    "editor.wordHighlightStrongBackground": "#F2DDE3B3",
    "editor.findMatchBackground": "#EDD98C",
    "editor.findMatchHighlightBackground": "#F5E8B5CC",
    "editor.rangeHighlightBackground": "#F5E8B566",
    "editorLineNumber.foreground": "#918577",
    "editorLineNumber.activeForeground": "#403A36",
    "editorWhitespace.foreground": "#E0D6C7",
    "editorIndentGuide.background1": "#ECE3D5",
    "editorIndentGuide.activeBackground1": "#C9BCA8",
    "editorRuler.foreground": "#E8DECF",
    "editorBracketMatch.background": "#DCE8D6CC",
    "editorBracketMatch.border": "#42634A",
    "editorBracketHighlight.foreground1": "#3E6489",
    "editorBracketHighlight.foreground2": "#88475F",
    "editorBracketHighlight.foreground3": "#42634A",
    "editorBracketHighlight.foreground4": "#875A14",
    "editorBracketHighlight.foreground5": "#6A5486",
    "editorBracketHighlight.foreground6": "#356B6C",
    "editorBracketHighlight.unexpectedBracket.foreground": "#A33F37",
    "editorError.foreground": "#A33F37",
    "editorWarning.foreground": "#875A14",
    "editorInfo.foreground": "#3E6489",
