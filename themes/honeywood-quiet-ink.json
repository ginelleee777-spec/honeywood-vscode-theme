    "editorCodeLens.foreground": "#6E6158",
    "editorInlayHint.background": "#DCEAF799",
    "editorInlayHint.foreground": "#655C55",
    "editorWidget.background": "#FFFDF8",
    "editorWidget.border": "#C5D8EB",
    "editorSuggestWidget.background": "#FFFDF8",
    "editorSuggestWidget.border": "#C5D8EB",
    "editorSuggestWidget.selectedBackground": "#C4D9EE",
    "editorSuggestWidget.highlightForeground": "#88475F",
    "editorHoverWidget.background": "#FFFDF8",
    "editorHoverWidget.border": "#C5D8EB",
    "menu.background": "#FFFDF8",
    "menu.foreground": "#403A36",
    "menu.selectionBackground": "#C4D9EE",
    "menu.selectionForeground": "#403A36",
    "menu.border": "#C5D8EB",
    "input.background": "#FFFDF8",
    "input.foreground": "#403A36",
    "input.border": "#C5D8EB",
    "input.placeholderForeground": "#6E6158",
    "inputOption.activeBorder": "#3E6489",
    "dropdown.background": "#FFFDF8",
    "dropdown.border": "#C5D8EB",
    "button.background": "#3E6489",
    "button.foreground": "#FFF9F0",
    "button.hoverBackground": "#547A9F",
    "button.secondaryBackground": "#DCE8D6",
    "button.secondaryForeground": "#403A36",
    "badge.background": "#98566D",
    "badge.foreground": "#FFF9F0",
    "progressBar.background": "#3E6489",
    "scrollbarSlider.background": "#403A3626",
    "scrollbarSlider.hoverBackground": "#403A3640",
    "scrollbarSlider.activeBackground": "#403A3659",
    "notifications.background": "#FFFDF8",
    "notifications.border": "#C5D8EB",
    "quickInput.background": "#FFFDF8",
    "statusBar.background": "#DCEAF7",
    "statusBar.foreground": "#403A36",
    "statusBar.border": "#C5D8EB",
    "statusBar.noFolderBackground": "#DCE8D6",
    "statusBar.debuggingBackground": "#F2DDE3",
    "statusBar.debuggingForeground": "#403A36",
    "statusBarItem.hoverBackground": "#C4D9EE",
    "statusBarItem.remoteBackground": "#3E6489",
    "statusBarItem.remoteForeground": "#FFF9F0",
    "panel.background": "#FFF9F0",
    "panel.border": "#E8DECF",
    "panelTitle.activeForeground": "#403A36",
    "panelTitle.inactiveForeground": "#655C55",
    "panelTitle.activeBorder": "#3E6489",
    "terminal.background": "#FFF9F0",
    "terminal.foreground": "#403A36",
    "terminalCursor.foreground": "#3E6489",
    "terminal.selectionBackground": "#D4E4F4",
    "peekView.border": "#547A9F",
    "peekViewEditor.background": "#FBF4E8",
    "peekViewResult.background": "#DCEAF7",
    "peekViewTitle.background": "#D0E2F3",
    "peekViewEditor.matchHighlightBackground": "#EDD98C",
    "peekViewResult.matchHighlightBackground": "#EDD98C",
    "diffEditor.insertedTextBackground": "#4E705426",
    "diffEditor.removedTextBackground": "#98566D26",
    "diffEditor.insertedLineBackground": "#DCE8D699",
    "diffEditor.removedLineBackground": "#F2DDE399",
    "gitDecoration.addedResourceForeground": "#42634A",
    "gitDecoration.untrackedResourceForeground": "#42634A",
    "gitDecoration.modifiedResourceForeground": "#3E6489",
    "gitDecoration.deletedResourceForeground": "#A33F37",
    "gitDecoration.conflictingResourceForeground": "#875A14",
    "gitDecoration.ignoredResourceForeground": "#5F758B",
    "minimap.background": "#FFF9F0",
    "minimapSlider.background": "#403A361A",
    "terminal.ansiBlack": "#403A36",
    "terminal.ansiRed": "#A33F37",
    "terminal.ansiGreen": "#42634A",
    "terminal.ansiYellow": "#875A14",
    "terminal.ansiBlue": "#3E6489",
    "terminal.ansiMagenta": "#88475F",
    "terminal.ansiCyan": "#356B6C",
    "terminal.ansiWhite": "#B8AEA3",
    "terminal.ansiBrightBlack": "#6E6158",
    "terminal.ansiBrightRed": "#B0463D",
    "terminal.ansiBrightGreen": "#47704F",
    "terminal.ansiBrightYellow": "#8E6A1F",
    "terminal.ansiBrightBlue": "#466E99",
    "terminal.ansiBrightMagenta": "#965069",
    "terminal.ansiBrightCyan": "#397476",
    "terminal.ansiBrightWhite": "#E9E0D3"
  },
  "tokenColors": [
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#403A36"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#524A44"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#524A44"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#974B65"
      }
    },
    {
      "name": "storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#974B65"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3D6E45"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#3D6E45",
        "fontStyle": "bold"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#875A14"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#875A14"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#35669A"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#403A36",
        "fontStyle": "bold"
      }
    },
    {
      "name": "parameter",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#403A36",
        "fontStyle": "italic"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#403A36"
      }
    },
    {
      "name": "self",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#974B65",
        "fontStyle": "italic"
      }
    },
    {
      "name": "decorator",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#35669A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#974B65"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#875A14"
      }
    },
    {
      "name": "cssSelector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.pseudo-class.css"
      ],
      "settings": {
        "foreground": "#35669A"
      }
    },
    {
      "name": "cssProperty",
      "scope": [
        "support.type.property-name",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#403A36"
      }
    },
    {
      "name": "cssValue",
      "scope": [
        "support.constant.property-value",
        "support.constant.color",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#875A14"
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6E6158",
        "fontStyle": "italic"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#A33F37",
        "fontStyle": "underline"
      }
    },
    {
      "name": "markupHeading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#35669A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markupLink",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#35669A",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#35669A",
    "method": "#35669A",
    "class": {
      "foreground": "#403A36",
      "bold": true
    },
    "interface": {
      "foreground": "#403A36",
      "bold": true
    },
    "type": {
      "foreground": "#403A36",
      "bold": true
    },
    "enum": {
      "foreground": "#403A36",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#403A36",
      "bold": true
    },
    "namespace": "#403A36",
    "parameter": {
      "foreground": "#403A36",
      "italic": true
    },
    "variable": "#403A36",
    "property": "#403A36",
    "variable.readonly": "#403A36",
    "variable.defaultLibrary": "#875A14",
    "enumMember": "#875A14",
    "decorator": {
      "foreground": "#35669A",
      "italic": true
    },
    "selfParameter": {
      "foreground": "#974B65",
      "italic": true
    }
  }
}
